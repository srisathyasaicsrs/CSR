# Cloudflare Worker Environment Variables Template
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here

# R2 Storage S3 API Credentials
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# 21st.dev Component API Key Template
TWENTY_FIRST_DEV_API_KEY=your_21st_dev_key_here
