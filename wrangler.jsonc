{
  "name": "sss-csr-portal",
  "account_id": "dee21334b5c77859d1be78cb7be13a3b",
  "main": "src/index.js",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "srisathyasaicsr.com",
      "custom_domain": true
    },
    {
      "pattern": "www.srisathyasaicsr.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sss-csr-db",
      "database_id": "4c75dea8-3281-4768-b030-588dc7efab2b"
    }
  ]
}
